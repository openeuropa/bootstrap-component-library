{# Parameters:
  - id (string): unique ID; generated when omitted
  - label (string): accessible carousel name, defaults to 'Featured content'
  - layout (string): 'split' (default) or 'full_width' (hero)
  - full_bleed (boolean): false by default; span the page from inside .container
  - autoplay (boolean): true by default; reduced motion always starts paused
  - interval (integer): rotation interval in milliseconds (default 10000; minimum 8000)
  - active_item (integer): 1-based initial slide (default 1)
  - disable_touch (boolean): false by default
  - items (array): image (rendered img/picture), caption_title, caption (rendered
    content), link (BCL link object), copyright, copyright_label, interval
  - title_tag (string): slide heading level from the page context, defaults to p
  - prev_label, next_label, pause_label, play_label (strings): translated actions
  - slide_label (string): translated '%current% of %total%' template
  - carousel_role_label, slide_role_label (strings): translated role descriptions
  - icon_path (string): BCL icon sprite
  - attributes (Drupal attributes)
  Image markup is supplied by the caller, including alt, dimensions and srcset.
  Controls are progressively enhanced; without JavaScript all slides are visible.
#}
{%- set _items = items|default([]) -%}
{%- set _id = id|default('bcl-carousel-v2-' ~ random(1000000000)) -%}
{%- set _layout = layout|default('split') -%}
{%- set _layout = _layout in ['split', 'full_width'] ? _layout : 'split' -%}
{%- set _active = active_item|default(1) -%}
{%- set _active = _active >= 1 and _active <= _items|length ? _active : 1 -%}
{%- set _title_tag = title_tag|default('p') -%}
{%- set _title_tag = _title_tag in ['p', 'h2', 'h3', 'h4', 'h5', 'h6'] ? _title_tag : 'p' -%}
{%- set _interval = interval|default(10000) -%}
{%- set _interval = _interval > 0 ? (_interval < 8000 ? 8000 : _interval) : 10000 -%}
{%- set _icon_path = icon_path|default('') -%}
{%- set _slide_label = slide_label|default('%current% of %total%') -%}
{%- set attributes = attributes ?: create_attribute() -%}
{# Hover must not pause rotation. Keep data-bs-pause="false". #}
{%- set attributes = attributes.addClass(['bcl-carousel-v2', 'bcl-carousel-v2--' ~ _layout, 'carousel', 'slide'])
  .setAttribute('id', _id)
  .setAttribute('role', 'region')
  .setAttribute('aria-roledescription', carousel_role_label|default('carousel'))
  .setAttribute('aria-label', label|default('Featured content'))
  .setAttribute('data-bcl-autoplay', autoplay ?? true ? 'true' : 'false')
  .setAttribute('data-bs-interval', _interval)
  .setAttribute('data-bs-touch', disable_touch ?? false ? 'false' : 'true')
  .setAttribute('data-bs-ride', 'false')
  .setAttribute('data-bs-pause', 'false')
  .setAttribute('data-bcl-pause-on-hover', 'false')
-%}
{%- if full_bleed ?? false -%}
  {%- set attributes = attributes.addClass('bcl-carousel-v2--full-bleed') -%}
{%- endif -%}
{%- if _layout == 'split' -%}
  {%- set attributes = attributes.addClass('carousel-fade') -%}
{%- endif -%}
{%- if _items is not empty -%}
<section{{ attributes }}>{#- -#}
  {%- if _items|length > 1 -%}
    {#- WAI carousel pattern: rotation control first in tab order; CSS positions it for each layout. -#}
    <div class="bcl-carousel-v2__controls" hidden>{#- -#}
      <button type="button" class="btn btn-outline-primary bcl-carousel-v2__control" data-bcl-rotation
        data-bcl-play-label="{{ play_label|default('Play slides') }}"
        data-bcl-pause-label="{{ pause_label|default('Pause slides') }}"
        aria-label="{{ play_label|default('Play slides') }}" aria-controls="{{ _id }}-slides">{#- -#}
        <span data-bcl-play-icon aria-hidden="true">{%- include '@oe-bcl/bcl-icon/icon.html.twig' with {name: 'play-fill', path: _icon_path} only -%}</span>{#- -#}
        <span data-bcl-pause-icon aria-hidden="true" hidden>{%- include '@oe-bcl/bcl-icon/icon.html.twig' with {name: 'pause-fill', path: _icon_path} only -%}</span>{#- -#}
      </button>{#- -#}
      <div class="bcl-carousel-v2__navigation">{#- -#}
        <button type="button" class="btn btn-outline-primary bcl-carousel-v2__control" data-bs-target="#{{ _id }}" data-bs-slide="prev"
          aria-label="{{ prev_label|default('Previous slide') }}" aria-controls="{{ _id }}-slides">{#- -#}
          {%- include '@oe-bcl/bcl-icon/icon.html.twig' with {name: 'chevron-left', path: _icon_path, attributes: create_attribute().setAttribute('aria-hidden', 'true')} only -%}
        </button>{#- -#}
        <button type="button" class="btn btn-outline-primary bcl-carousel-v2__control" data-bs-target="#{{ _id }}" data-bs-slide="next"
          aria-label="{{ next_label|default('Next slide') }}" aria-controls="{{ _id }}-slides">{#- -#}
          {%- include '@oe-bcl/bcl-icon/icon.html.twig' with {name: 'chevron-right', path: _icon_path, attributes: create_attribute().setAttribute('aria-hidden', 'true')} only -%}
        </button>{#- -#}
        <span class="bcl-carousel-v2__counter" aria-hidden="true"><span data-bcl-current>{{ _active }}</span>/<span>{{ _items|length }}</span></span>{#- -#}
      </div>{#- -#}
    </div>{#- -#}
  {%- endif -%}
  <div class="carousel-inner" id="{{ _id }}-slides" aria-live="off">{#- -#}
    {%- for item in _items -%}
      {%- set _position = _slide_label|replace({'%current%': loop.index, '%total%': _items|length}) -%}
      {%- set _title = item.caption_title|default('')|striptags|trim -%}
      <div class="carousel-item{{ loop.index == _active ? ' active' : '' }}" role="group" aria-roledescription="{{ slide_role_label|default('slide') }}"
        aria-label="{{ (_title ? _title ~ ' — ' ~ _position : _position)|escape('html_attr') }}"
        {% if item.interval is defined and item.interval > 0 %}data-bs-interval="{{ item.interval < 8000 ? 8000 : item.interval }}"{% endif %}>{#- -#}
        <div class="bcl-carousel-v2__layout">{#- -#}
          <div class="bcl-carousel-v2__image">{#- -#}
            <span class="bcl-carousel-v2__progress" aria-hidden="true" hidden></span>{{ item.image }}{#- -#}
          </div>{#- -#}
          {%- if item.copyright is not empty -%}
            <div class="bcl-carousel-v2__copyright"><span class="visually-hidden">{{ item.copyright_label|default('Image credit:') }} </span>{{ item.copyright }}</div>{#- -#}
          {%- endif -%}
          {%- if item.caption_title is not empty or item.caption is not empty or item.link is not empty -%}
            <div class="bcl-carousel-v2__content">{#- -#}
              {%- if item.caption_title is not empty -%}<{{ _title_tag }} class="bcl-carousel-v2__title">{{ item.caption_title }}</{{ _title_tag }}>{%- endif -%}
              {%- if item.caption is not empty -%}<div class="bcl-carousel-v2__description">{{ item.caption }}</div>{%- endif -%}
              {%- if item.link is not empty -%}
                {%- include '@oe-bcl/bcl-link/link.html.twig' with item.link|merge({attributes: (item.link.attributes ?: create_attribute()).addClass(['btn', 'btn-primary'])}) only -%}
              {%- endif -%}
            </div>{#- -#}
          {%- endif -%}
        </div>{#- -#}
      </div>{#- -#}
    {%- endfor -%}
  </div>{#- -#}
</section>{#- -#}
{%- endif -%}
